---
layout: _base.njk
---

{% for collection in [collections.caseStudyProjects, collections.screenshotsProjects, collections.petProjects] %}
	<section class="project-list-container --{{ loop.index }}">
		<div class="container">
			{% if loop.index == 1 %}
				<h1>{{ title }}</h1>
				{{ content | safe }}
			{% endif %}

			<div class="heading-row">
				<h2 aria-describedby="counter-{{ loop.index }}">{{ sectionName[loop.index0] }}</h2>
			</div>
			{% set layout = "default" if loop.index == 1 else "compact" %}
			<div class="project-list --{{ layout }}">
				{% for project in collection %}
					<article class="project-card --{{ layout }}">
						{%if layout == "default" %}
							{% setAsync "imageHtml" %}
								{% image src=project.fileSlug + "/cover.jpg", className="project-card__img --" + layout, alt="", width=450, priority="high" %}
							{% endsetAsync %}
							{{ imageHtml | safe }}
						{% endif %}
						<div class="project-card__text">
							{% if project.data.company %}
								<div class="project-card__company">{{ project.data.company }}</div>
							{% endif %}
							<a class="project-card__link" href="{{ project.data.permalink }}">
								{{ project.data.title }}
							</a>
							{% if project.data.result %}
								<div class="project-card__result">Outcome: {{ project.data.result }}</div>
							{% endif %}
							{% if project.data.labels %}
								<ul class="tags project-card__labels" aria-label="Industry and audience">
									{%- for label in project.data.labels -%}
									<li class="tag">{{ label }}</li>
									{%- endfor -%}
								</ul>
							{% elif project.data.description %}
								<div class="project-card__desc">{{ project.data.description }}</div>
							{% endif %}
					{% if project.data.highlights %}
					<ul class="project-card__highlights">
						{%- for item in project.data.highlights -%}
						<li>{{ item }}</li>
						{%- endfor -%}
					</ul>
					{% endif %}

						</div>
					</article>
				{% endfor %}
			</div>
		</div>
	</section>
{% endfor %}

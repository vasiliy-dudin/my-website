{
  "name": "my-website",
  "description": "",
  "author": "Vasya Dudin",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "watch": "npm-run-all --parallel _watch:*",
    "build": "cross-env-shell ELEVENTY_ENV=production \"npm-run-all _build:sass _build:lightningcss _build:js && eleventy && pnpm _build:html\"",
    "deploy": "vercel deploy ./dist --prod",
    "build+deploy": "pnpm run build && pnpm run deploy",
    "_watch:11ty": "eleventy --serve --port=3000",
    "_watch:sass": "sass --watch --style=expanded src/styles/bundle.sass:dist/styles/bundle.css src/styles/fancybox.sass:dist/styles/fancybox.css",
    "_watch:js": "rollup -c -w",
    "_build:sass": "sass --no-source-map src/styles/bundle.sass:dist/styles/bundle.css src/styles/fancybox.sass:dist/styles/fancybox.css",
    "_build:lightningcss": "lightningcss --minify --bundle dist/styles/bundle.css -d dist/styles && lightningcss --minify --bundle dist/styles/fancybox.css -d dist/styles",
    "_build:js": "rollup -c",
    "_build:html": "html-minifier-terser --input-dir dist --output-dir dist --file-ext html --collapse-whitespace --remove-comments --minify-css --minify-js",
    "_remove-dist": "rimraf dist"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@fancyapps/ui": "^6.1.15",
    "@mdit/plugin-inline-rule": "^2.2.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@uncenter/eleventy-plugin-toc": "^2.1.2",
    "cross-env": "^10.1.0",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^5.5.0",
    "lightningcss-cli": "^1.33.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.67.4",
    "sass": "^1.107.1",
    "vercel": "^65.10.0"
  }
}
